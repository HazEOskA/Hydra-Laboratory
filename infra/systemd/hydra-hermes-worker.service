[Unit]
Description=Hydra Hermes continuous duty cycle
Documentation=https://github.com/HazEOskA/hydra-hermes-lab/blob/main/docs/CONTINUOUS_OPERATION.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=hydra
Group=hydra
WorkingDirectory=/home/hydra/hydra-hermes-lab
EnvironmentFile=/etc/hydra-hermes/worker.env
ExecStart=/home/hydra/hydra-hermes-lab/scripts/hermes-worker.sh --execute
Restart=always
RestartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM

# Hardening. The worker only needs its own state directory and the host CLI.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/hydra-hermes
StateDirectory=hydra-hermes
UMask=0077

# Journal only; the duty cycle writes its own sanitized records under the state directory.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
