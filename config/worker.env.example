# Non-secret duty-cycle configuration. Install as /etc/hydra-hermes/worker.env
# (mode 0640, owner root:hydra) and review before enabling the worker service.
#
# This file must never contain NVIDIA_INFERENCE_API_KEY or any other credential.
# The worker never sees the provider key: it prompts Hermes through the sandbox
# boundary, and the key stays host-side with the Model Router.

NEMOCLAW_SANDBOX_NAME=hydra-hermes-lab

# Where journal, per-task state, budget counters, and reports are written.
HERMES_WORKER_STATE_DIR=/var/lib/hydra-hermes/worker

# Task manifests. Point at the checked-out repository on the host.
HERMES_WORKER_TASK_DIR=/home/hydra/hydra-hermes-lab/tasks

# Spend controls. The subscription is fixed-price, not unmetered: these caps are
# what keep a 24/7 loop inside a predictable request budget.
# 240 prompts/day with a 60s floor is roughly one prompt every six minutes.
HERMES_WORKER_DAILY_PROMPT_CAP=240
HERMES_WORKER_MIN_PROMPT_INTERVAL_SECONDS=60

# How long to wait when no task is due.
HERMES_WORKER_IDLE_SLEEP_SECONDS=30

# Consecutive failures on any single task before the circuit breaker halts the
# loop. Clear a tripped breaker with: scripts/hermes-worker.sh --resume
HERMES_WORKER_FAILURE_THRESHOLD=5

# Upper bound on a single joined prompt, in characters.
HERMES_WORKER_MAX_PROMPT_CHARS=1200
